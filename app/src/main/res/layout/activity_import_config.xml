<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Импорт конфига PumbaNET"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/qrScanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сканировать QR-код"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Или вставьте конфиг вручную:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/configEditText"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="vless://... или JSON"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/manualImportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Импортировать"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
