<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Design 3 Theme -->
    <style name="Theme.PumbaNET" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_light</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:colorBackgroundCacheHint">@color/background_dark</item>
    </style>

    <!-- Glassmorphism Card Style -->
    <style name="GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/glass_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Modern Button Style -->
    <style name="ModernButton" parent="Widget.Material3.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Gradient Button -->
    <style name="GradientButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/gradient_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- Icon Button -->
    <style name="IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/on_surface_dark</item>
        <item name="backgroundTint">@color/surface_variant_dark</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
